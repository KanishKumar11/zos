# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_INVITE_SECRET=change-me-invite-secret-min-16-chars
JWT_INVITE_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset-secret-min-16-chars
JWT_RESET_EXPIRES_IN=1h

# ─── Encryption ──────────────────────────────────────────────────────────────
# Must be at least 32 characters
ENCRYPTION_KEY=change-me-encryption-key-min-32-characters!

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp-password
SMTP_FROM=no-reply@example.com

# ─── S3 / MinIO ──────────────────────────────────────────────────────────────
# For local MinIO: S3_ENDPOINT=http://minio:9000
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=agency-panel
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# ─── Throttle ────────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=20

# ─── Seed (optional) ─────────────────────────────────────────────────────────
SEED_OWNER_EMAIL=admin@example.com
SEED_OWNER_PASSWORD=Admin@123456
SEED_OWNER_NAME=Admin

# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/agency

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
JWT_INVITE_SECRET=change-me-invite
JWT_INVITE_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset
JWT_RESET_EXPIRES_IN=1h

# --- Crypto (AES-256 for bank details) ---
ENCRYPTION_KEY=change-me-32-byte-base64-key====

# --- Mail (SMTP / Mailhog by default) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agency Panel <noreply@agency.local>"

# --- Storage (S3 / MinIO by default) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agency
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Bootstrap owner (used by seed) ---
SEED_OWNER_EMAIL=owner@agency.local
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_NAME="Agency Owner"

# --- Throttling ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=20

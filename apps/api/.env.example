# --- App ---
NODE_ENV=production
PORT=4000
APP_URL=https://api.yourdomain.com
WEB_URL=https://yourdomain.com

# --- Database ---
# In Coolify docker-compose stack, use the service name "mongo" as hostname
MONGO_URI=mongodb://mongo:27017/agency

# --- JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
JWT_INVITE_SECRET=change-me-invite
JWT_INVITE_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset
JWT_RESET_EXPIRES_IN=1h

# --- Crypto (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
ENCRYPTION_KEY=change-me-32-byte-base64-key====

# --- Mail ---
# Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # 16-char app password (no spaces)
SMTP_FROM="Agency Panel <you@gmail.com>"
# Outlook/Hotmail alternative:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@outlook.com
# SMTP_PASS=your-password

# --- Storage (Cloudflare R2) ---
# ACCOUNT_ID: Cloudflare dashboard → right sidebar
# Access key: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=agency
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_TTL_SECONDS=900

# --- Bootstrap owner (used by seed) ---
SEED_OWNER_EMAIL=owner@yourdomain.com
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_NAME="Agency Owner"

# --- Throttling ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=20

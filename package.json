{
  "name": "agency-panel",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "seed": "pnpm --filter @agency/api seed",
    "prepare": "husky || true",
    "deploy": "docker compose up -d --build",
    "deploy:infra": "docker compose up -d minio",
    "deploy:api": "docker compose up -d --build api",
    "deploy:web": "docker compose up -d --build web",
    "deploy:down": "docker compose down",
    "deploy:logs:api": "docker compose logs -f api",
    "deploy:logs:web": "docker compose logs -f web"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.7",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
